{
  "name": "mocktest",
  "main": "src/index.js",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mocktest", "migrations_dir": "migrations" }
  ],
  "vars": {
    "SITE_NAME": "MockTest Lab",
    "SITE_URL": "",
    "ADMIN_EMAIL": "",
    "MAIL_FROM": "MockTest <noreply@example.com>",
    "PORTONE_STORE_ID": "",
    "PORTONE_CHANNEL_KEY": "",
    "BIZ_NAME": "(상호명 입력)",
    "BIZ_OWNER": "(대표자명)",
    "BIZ_REG_NO": "(사업자등록번호)",
    "BIZ_SALES_NO": "(통신판매업 신고번호)",
    "BIZ_ADDRESS": "(사업장 주소)",
    "BIZ_CONTACT": "(고객센터 이메일/전화)"
  }
}
