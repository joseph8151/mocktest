{
  "name": "mocktest",
  "main": "src/index.js",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mocktest", "migrations_dir": "migrations" }
  ],
  // keep_vars: values added in the Cloudflare dashboard survive every deploy. Put MAIL_FROM, BIZ_* (business info),
  // PORTONE_STORE_ID, PORTONE_CHANNEL_KEY, KCP_SITE_CD ... there as Text, and API keys as Secret. Do not add them here:
  // a value in this file overwrites the dashboard on every deploy.
  "keep_vars": true,
  "vars": {
    "SITE_NAME": "MockTest Lab",
    "SITE_URL": "",
    "ADMIN_EMAIL": ""
  }
}
