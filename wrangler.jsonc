{
  "name": "mocktest",
  "main": "src/index.js",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "compatibility_date": "2025-09-01",
  // Run the Worker close to the database: pages that need several D1 queries finish much faster for far-away visitors.
  "placement": { "mode": "smart" },
  // Smaller upload and faster cold starts (the Anthropic SDK used for AI grading is large).
  "minify": true,
  // Stamps ?v=<hash> on app.js / style.css in index.html so browsers can cache them for a year.
  "build": { "command": "node scripts/stamp-assets.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/_seed/*"]
  },
  // Workers AI: speech-to-text (Whisper) for speaking answers before AI grading.
  "ai": { "binding": "AI" },
  // Every 10 minutes: AI-grade any writing/speaking answers still waiting (only when ANTHROPIC_API_KEY is set).
  "triggers": { "crons": ["*/10 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "mocktest", "migrations_dir": "migrations" }
  ],
  // keep_vars: values added in the Cloudflare dashboard survive every deploy. Put MAIL_FROM, BIZ_* (business info),
  // PORTONE_STORE_ID, PORTONE_CHANNEL_KEY, KCP_SITE_CD ... there as Text, and API keys as Secret. Do not add them here:
  // a value in this file overwrites the dashboard on every deploy.
  "keep_vars": true,
  "vars": {
    "SITE_NAME": "MockTest Lab",
    "SITE_URL": "",
    "ADMIN_EMAIL": "",
    // Operator alerts (new member, new 무통장입금 order) go to this Formspree form's owner by e-mail.
    "FORMSPREE_URL": "https://formspree.io/f/maeoerpk",
    // Business details shown in the footer (전자상거래법 표시 의무). Add BIZ_NAME, BIZ_OWNER, BIZ_SALES_NO, BIZ_CONTACT here too.
    "BIZ_REG_NO": "654-60-00645",
    "BIZ_ADDRESS": "서울 서초구 강남대로8길 39-26"
  }
}
