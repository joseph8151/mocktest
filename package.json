{
  "name": "mocktest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "seed:gen": "node scripts/gen-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply mocktest --local",
    "db:migrate:remote": "wrangler d1 migrations apply mocktest --remote",
    "db:seed:local": "wrangler d1 execute mocktest --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute mocktest --remote --file=seed/seed.sql",
    "test": "node --test test/unit.test.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": { "hono": "^4.13.0" },
  "devDependencies": { "wrangler": "^4.0.0" }
}
